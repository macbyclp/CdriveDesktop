<Window x:Class="CdriveDesktop.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Cdrive" Height="800" Width="1120"
        MinHeight="360" MinWidth="480"
        Background="#0b0b0f"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <wv2:WebView2 x:Name="Web" />

        <!-- İndirme bilgisi: window.open ile açılan bağlantıların çoğu aslında bir
             indirme (dosya, klasör zip'i, fatura PDF'i). O durumda sayfa boş kalır;
             kullanıcı "boş pencere açıldı" sanmasın diye bu katman görünür. -->
        <Border x:Name="DownloadPanel" Background="#0b0b0f" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="DownloadText" Text="İndiriliyor…" Foreground="#e5e7eb"
                           FontSize="15" HorizontalAlignment="Center" />
                <TextBlock x:Name="DownloadName" Text="" Foreground="#9ca3af"
                           FontSize="12" Margin="0,8,0,0" MaxWidth="420" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
