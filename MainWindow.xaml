<Window x:Class="CdriveDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Cdrive" Height="860" Width="1280"
        MinHeight="480" MinWidth="720"
        Background="#08090c"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="Web" />

        <!-- Yükleniyor perdesi: WebView2 ilk açılışta birkaç saniye boş durabiliyor;
             uygulamanın donduğu izlenimini vermemek için üstünde marka rengiyle bir
             karşılama katmanı duruyor, sayfa gelince gizleniyor. Bağlantı hatasında
             da bu katman hatayı ve "Yeniden dene" düğmesini gösteriyor. -->
        <Border x:Name="Splash" Background="#08090c">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Marka işareti: Liquid Glass'ın nötr paleti (koyu temada açık zemin / koyu "C";
                     açık temada tersi). Renkleri kod tarafında tema değiştikçe güncellenir. -->
                <Border x:Name="SplashLogo" Width="72" Height="72" CornerRadius="20"
                        HorizontalAlignment="Center" Background="#f3f4f6">
                    <TextBlock x:Name="SplashLogoText" Text="C" Foreground="#08090c" FontSize="38"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="SplashText" Text="Cdrive açılıyor…" Foreground="#9ca3af"
                           FontSize="14" Margin="0,18,0,0" HorizontalAlignment="Center" />
                <TextBlock x:Name="SplashHint" Text="" Foreground="#6b7280"
                           FontSize="12" Margin="0,8,0,0" MaxWidth="440" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" />
                <Button x:Name="RetryButton" Content="Yeniden dene" Visibility="Collapsed"
                        Margin="0,16,0,0" Padding="16,6" HorizontalAlignment="Center"
                        Click="RetryButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
